# geo_opt, from Ivan's cp2k_opt.in (2026-10-05). Double-brace names are filled per structure.
&FORCE_EVAL
  &DFT
    CHARGE {{CHARGE}}
    BASIS_SET_FILE_NAME {{BASIS_FILE}}
    POTENTIAL_FILE_NAME {{POTENTIAL_FILE}}
    &MGRID
      CUTOFF  400
      REL_CUTOFF  60
      NGRIDS  4
    &END
    &POISSON
       POISSON_SOLVER MULTIPOLE
       PERIODIC None
    &END
    &QS
      METHOD  gapw
      FORCE_PAW T             # makes Cd and S GAPW atoms
      GAPW_ACCURATE_XCINT T   # CP2K >= 2026.2
    &END
    &SCF
      &OT
        N_DIIS  7
        MINIMIZER  DIIS
        PRECONDITIONER FULL_KINETIC
      &END
      EPS_SCF  1e-6
      MAX_SCF 200
      IGNORE_CONVERGENCE_FAILURE  # the first geo_opt step usually needs all 200 cycles; later steps far fewer
      SCF_GUESS  restart      # falls back to an atomic guess when the .wfn does not exist
    &END
    WFN_RESTART_FILE_NAME {{WFN_FILE}}
    &XC
      &XC_FUNCTIONAL PBE
      &END
    &END
  &END
  &SUBSYS
    &TOPOLOGY
      COORDINATE XYZ
      COORD_FILE_NAME {{COORD_FILE}}
      &CENTER_COORDINATES
      &END
    &END
    &CELL
      ABC {{CELL}}
      PERIODIC None
    &END
{{KINDS}}
  &END
&END

{{MOTION}}
&GLOBAL
  PRINT_LEVEL low
  PROJECT  {{PROJECT}}
  RUN_TYPE GEO_OPT
&END
